# Copy to .env. Secrets only - everything structural lives in config.toml.

# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# One RCON password + one database URL per server in config.toml.
# Each Minecraft server needs its OWN database - do not point two at the same one.
ATM10_RCON_PASSWORD=
ATM10_DATABASE_URL=jdbc:mysql://user:password@host:3306/atm10

DECEASEDCRAFT_RCON_PASSWORD=
DECEASEDCRAFT_DATABASE_URL=jdbc:mysql://user:password@host:3306/deceasedcraft

# Pterodactyl client API key (Account -> API Credentials in the panel) for
# /restart. The account must have access to every server in config.toml.
PTERODACTYL_API_KEY=
